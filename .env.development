# `npm start` (development). Points at your local auth-service (compose.yaml + uvicorn, ENVIRONMENT=dev:
# fake SMS sender, the code appears in its log, ₪0). On the S22 over USB run once per connection:
#   adb reverse tcp:8000 tcp:8000
# so the phone's localhost:8000 reaches the Mac. Override per machine in .env.development.local (gitignored).
# Public by design (baked into the bundle): never put a secret here.
EXPO_PUBLIC_API_URL=http://localhost:8000
