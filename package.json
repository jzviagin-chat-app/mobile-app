{
  "name": "mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "prestart": "npm run reverse",
    "start": "expo start --dev-client",
    "preandroid": "npm run reverse",
    "android": "expo run:android --device",
    "ios": "expo run:ios",
    "reverse": "adb reverse tcp:8000 tcp:8000 || true",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "doctor": "expo-doctor",
    "api:gen": "node scripts/api-gen.mjs"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.106.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.7.2",
    "libphonenumber-js": "^1.13.15",
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.21.6",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@locales/(.*)$": "<rootDir>/locales/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.context/",
      "/ios/",
      "/android/"
    ],
    "clearMocks": true,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|mobx|mobx-react-lite|react-native-keyboard-controller))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "watchman": false
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-masked-view/masked-view",
          "expo-modules-core"
        ]
      }
    }
  }
}
